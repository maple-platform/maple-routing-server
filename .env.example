# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=maple_db
MAIN_DOCUMENT_ID=                        # MongoDB departments 컬렉션 문서 ObjectId

# AI Agent (H100 서버 — A100↔H100 사설망 직결, 터널 불필요)
# H100 서버의 사설 IP:8101 을 직접 지정. 사설 IP 확인: 각 서버에서 `ip addr show ens224`
AGENT_URL=http://<H100-사설IP>:8101
AGENT_TIMEOUT=300

# 추론 서버
MAPLE_INFERENCE_URL=http://localhost:8110
MAPLE_INFERENCE_HEALTH_PATH=/health
MAPLE_REMOTE_INFERENCE_URL=

# 모델 경로
AI_MODELS_DIR=../maple-model-execution-server/AI_Models
MODEL_ROOT=
